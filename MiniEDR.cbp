<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<CodeBlocks_project_file>
    <FileVersion major="1" minor="6" />
    <Project>
        <Option title="MiniEDR V2" />
        <Option pch_mode="2" />
        <Option compiler="gcc" />
        <Build>
            <Target title="Debug">
                <Option output="bin\Debug\MiniEDR.exe" prefix_auto="1" extension_auto="1" />
                <Option object_output="obj\Debug\" />
                <Option type="1" />
                <Option compiler="gcc" />
            </Target>
            <Target title="Release">
                <Option output="bin\Release\MiniEDR.exe" prefix_auto="1" extension_auto="1" />
                <Option object_output="obj\Release\" />
                <Option type="1" />
                <Option compiler="gcc" />
                <Option optimize="2" />
            </Target>
        </Build>
        <Compiler>
            <Add option="-Wall" />
            <Add option="-Wextra" />
            <Add option="-std=c11" />
        </Compiler>
        <Linker>
            <Add library="kernel32" />
        </Linker>
        <Unit filename="main.c" />
        <Unit filename="edr.c" />
        <Unit filename="edr.h" />
        <Unit filename="logger.c" />
        <Unit filename="logger.h" />
        <Unit filename="process.c" />
        <Unit filename="process.h" />
        <Unit filename="scanner.c" />
        <Unit filename="scanner.h" />
        <Unit filename="monitor.c" />
        <Unit filename="monitor.h" />
        <Extensions>
            <code_completion />
            <debugger />
        </Extensions>
    </Project>
</CodeBlocks_project_file>
